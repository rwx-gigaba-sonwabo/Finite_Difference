def _as_path_vector(x, n_paths: int) -> np.ndarray:
    """Coerce any CPI value -- scalar, 0-d, (1,), (n_paths,), or a stray
    (n_paths, 1) column -- to a clean (n_paths,) array. This is the single
    choke point that makes every return from _get_cpi_level shape-safe,
    regardless of how upstream code (cpi_fixings stamping, hist_map, the
    inflation-rate curve) happened to shape its value."""
    arr = np.asarray(x, dtype=np.float64).reshape(-1)
    if arr.size == 1:
        return np.full(n_paths, float(arr[0]))
    if arr.size != n_paths:
        raise ValueError(
            f"CPI value has {arr.size} elements, expected 1 or {n_paths} "
            f"(original shape {np.asarray(x).shape})"
        )
    return arr


def _get_cpi_level(
    ref_date: date,
    val_date: date,
    cpi_interp: Optional[Callable],
    hist_map: Dict[date, float],
    curve_day_counter: ql.DayCounter,
    ql_val: ql.Date,
    n_paths: int,
    cpi_fixings: Optional[Dict[date, np.ndarray]] = None,
    spot_cpi: Optional[np.ndarray] = None,
    inflation_rate_curve: Optional[YieldCurve] = None,
    last_pub_date: Optional[date] = None,
) -> np.ndarray:
    """Return the CPI level at ``ref_date`` as an ``(n_paths,)`` array.

    Mirrors RiskFlow's pv_index_cashflows/calc_index for Riskflow (two-curve)
    mode: no persisted "locked fixing" anchor -- every valuation date
    re-reads spot_cpi(val_date) and grows it forward via:
        CPI(ref_date) = spot_cpi(val_date) / DF_infl(T_last_pub(val_date) -> ref_date)
    """
    pub_cutoff = (
        last_pub_date
        if (last_pub_date is not None and inflation_rate_curve is not None)
        else val_date
    )

    if ref_date <= val_date:
        if cpi_fixings is not None and ref_date in cpi_fixings and ref_date <= pub_cutoff:
            return _as_path_vector(cpi_fixings[ref_date], n_paths)

        if ref_date in hist_map:
            return _as_path_vector(hist_map[ref_date], n_paths)

        if ref_date <= pub_cutoff:
            known = [k for k in hist_map if k <= pub_cutoff]
            if known:
                return _as_path_vector(hist_map[max(known)], n_paths)
            return np.zeros(n_paths, dtype=np.float64)

        if inflation_rate_curve is None:
            known = [k for k in hist_map if k <= val_date]
            if known:
                return _as_path_vector(hist_map[max(known)], n_paths)
            return np.zeros(n_paths, dtype=np.float64)
        # Riskflow mode: fall through to the same spot/DF projection used
        # for genuinely future dates -- RiskFlow treats "unpublished past"
        # and "future" identically.

    if inflation_rate_curve is not None:
        origin = to_ql_date(last_pub_date) if last_pub_date is not None else ql_val
        t_ref = float(curve_day_counter.yearFraction(origin, to_ql_date(ref_date)))
        df_infl = _as_path_vector(inflation_rate_curve.discount_factor(t_ref), n_paths)
        anchor = _as_path_vector(spot_cpi, n_paths)
        return anchor / df_infl

    # Legacy mode: interpolate CPI levels directly from the CurveSlice
    t_ref = float(curve_day_counter.yearFraction(ql_val, to_ql_date(ref_date)))
    return _as_path_vector(cpi_interp(t_ref), n_paths)
